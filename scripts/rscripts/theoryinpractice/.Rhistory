library(shiny)
library(DT)
library(tidyverse)
library(dplyr)
library(ggplot2)
labels <- c(0.0, 0.3, 0.6, 0.9)
bar1 <- c(1270, 1339, 1481, 1615)
bar2 <- c(1121, 1119, 1118, 1122)
df <- data.frame(
label = factor(rep(labels, 2)),
value = c(bar1, bar2),
group = rep(c("Bar 1", "Bar 2"), each = length(labels))
)
ggplot(df, aes(x = label, y = value, fill = group)) +
geom_bar(stat = "identity", position = "dodge") +
labs(x = "Labels", y = "Values", fill = "Legend") +
scale_fill_manual(values = c("steelblue", "orange")) +
theme_minimal()
labels <- c(0.0, 0.3, 0.6, 0.9)
ptp <- c(1270, 1339, 1481, 1615)
relay <- c(1121, 1119, 1118, 1122)
ptp_repositioning <- c(1281, 1292, 1324, 1409)
df <- data.frame(
label = factor(rep(labels, 3)),
value = c(ptp, ptp_repositioning, relay),
group = rep(c("Point-to-point", "Point-to-point with repositioning", "Relay"), each = length(labels))
)
ggplot(df, aes(x = label, y = value, fill = group)) +
geom_bar(stat = "identity", position = "dodge") +
labs(x = "Labels", y = "Values", fill = "Legend") +
scale_fill_manual(values = c("steelblue", "orange")) +
theme_minimal()
df
ggplot(df, aes(x = label, y = value, fill = group))
ggplot(df, aes(x = label, y = value, fill = group)) +
geom_bar(stat = "identity", position = "dodge") +
labs(x = "Labels", y = "Values", fill = "Legend") +
scale_fill_manual(values = c("steelblue", "orange", "pink")) +
theme_minimal()
ggplot(df, aes(x = label, y = value, fill = group)) +
geom_bar(stat = "identity", position = "dodge") +
labs(x = "Edge-level imbalance", y = "Kilometers per order", fill = "Legend") +
scale_fill_manual(values = c("steelblue", "orange", "pink")) +
theme_minimal()
