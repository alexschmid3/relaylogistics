geom_vline(data = meanhours, aes(xintercept = mean,
color = formulation), size=5)+
scale_colour_manual("", breaks = c("heterogeneous", "homogeneousdeadlines"),
values = c("#DA853E", "#649BCB"))+
scale_fill_manual("", breaks = c("heterogeneous", "homogeneousdeadlines"),
values = c("#DA853E", "#649BCB"))
alldata %>%
ggplot(aes(x=hours, color=formulation, fill=formulation)) +
